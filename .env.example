# Backend settings live in config/server.yml; Docker uses deployments/server-config.docker.yaml.
HTTP_PORT=8080
GRPC_PORT=8091
# WEB_PORT is only used by local Vite development.
WEB_PORT=5173
POSTGRES_PORT=35432
REDIS_PORT=36379
# Set a random GAOMING_SETUP_TOKEN (at least 32 bytes) through your deployment environment for first-time web setup.
# No passwords or host-specific configuration should be committed.
